{
  "name": "logo-ali-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST da plataforma Logo Alí (Node.js + Express + Supabase)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/seed.ts",
    "setup:storage": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/setup-storage.ts",
    "criar-admin": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/criar-admin.ts",
    "seed:fotos": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/fotos-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

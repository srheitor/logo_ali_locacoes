# Copie para .env e preencha (Supabase: Project Settings → API Keys).

PORT=3333
# Origens liberadas no CORS, separadas por vírgula (front local e GitHub Pages).
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
# Chave secreta "secret" (sb_secret_...). Também aceita SUPABASE_SERVICE_ROLE_KEY (legada).
# NUNCA exponha no front nem faça commit dela.
SUPABASE_SECRET_KEY=

# Segredo para assinar os tokens de sessão (mín. 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Opcional: validade dos tokens em segundos (padrão: 1 h e 7 dias).
# JWT_ACCESS_TTL_S=3600
# JWT_REFRESH_TTL_S=604800

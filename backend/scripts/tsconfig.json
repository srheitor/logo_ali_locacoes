{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "rootDir": "../..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["./*.ts"]
}
